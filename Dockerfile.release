# Release image, built by GoReleaser (dockers_v2) from the binaries the
# release already produced: no compiling here. To build from source, use
# Dockerfile instead. Keep the runtime in step with its runtime stage.
FROM alpine:3.24

# A fixed UID, so a host directory mounted at /app/data can be given to it
# (chown 10001:10001).
RUN apk add --no-cache ca-certificates tzdata \
    && addgroup -S -g 10001 app && adduser -S -u 10001 -G app app \
    && mkdir -p /app/data && chown app:app /app/data

ARG TARGETPLATFORM
COPY $TARGETPLATFORM/exemplar /usr/local/bin/exemplar

COPY LICENSE NOTICE THIRD_PARTY_NOTICES.md /usr/share/licenses/exemplar/

WORKDIR /app
COPY exemplar-config.toml .

USER app

# Mount a volume at /app/data to keep the database and blobs.
VOLUME ["/app/data"]
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget -q --spider http://127.0.0.1:8080/health || exit 1

ENTRYPOINT ["exemplar"]
CMD ["serve"]
