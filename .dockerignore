# Only source goes into the build. Local data and scratch files can hold real
# personal data (tmp/ holds emails to ingest), so they never enter the build
# context, let alone an image.
tmp/
data/
*.db
*.db-shm
*.db-wal
.env
*.key

# Build output, caches and tooling
bin/
dist/
.cache/
.git/
.github/
.claude/
.DS_Store
*.test
*.out
