# Copy to .env (git ignores it) and fill in. Used by docker-compose.yml.

# Image tag for the built exemplar image, and the version it reports.
EXEMPLAR_VERSION=dev

# Where the API listens on this machine. 0.0.0.0 shares it with the network:
# do that only behind a TLS proxy.
EXEMPLAR_BIND=127.0.0.1
EXEMPLAR_PORT=8080

# The anonymisation key: turns on ingest of real data and linked fakes.
# Make one with:  openssl rand -hex 32
# Keep it safe and keep it the same: fakes are derived from it, and a new key
# means new fakes for everyone. Leave empty to run without ingest.
EXEMPLAR_ANON_KEY=

# Largest upload one ingest or anonymise run accepts, in MiB.
EXEMPLAR_MAX_INGEST_MB=200

# Most ingest and anonymise runs the server holds at once, together. Every
# run needs memory for its upload (above).
EXEMPLAR_MAX_CONCURRENT_RUNS=4

# Presidio's workers: one per run above, so keep the two equal. Every worker
# needs about 768 MiB.
PRESIDIO_WORKERS=4

# Presidio pinned to the version exemplar is tested against; change it only
# to a version you have tested.
PRESIDIO_IMAGE=mcr.microsoft.com/presidio-analyzer:2.2.362
